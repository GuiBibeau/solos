# Solana: the only network switch. Point at mainnet RPC or a local Surfpool.
SOLANA_RPC_URL=
# Optional. Derived from SOLANA_RPC_URL (http -> ws, port+1 for localhost) when unset.
SOLANA_WS_URL=

# Executor: direct (default, the local signer) or engine (simulate and execute go to solos-engine).
SOLOS_EXECUTOR=
# Required when SOLOS_EXECUTOR=engine. The engine origin. No token in the URL.
SOLOS_ENGINE_URL=
# Bearer token. Required to start the engine, and required on a caller when SOLOS_EXECUTOR=engine.
SOLOS_ENGINE_TOKEN=

# Wallet: prefer `solos login --provider ...`, which stores a profile in ~/.config/solos.
# Select a profile per process (MCP clients pass only this):
SOLOS_PROFILE=
# Or override with an explicit signer (env always wins over profiles):
# base58 secret key or JSON byte array, as produced by `solana-keygen`.
SOLOS_SIGNER_PRIVATE_KEY=
# path to a Solana CLI keypair JSON file
SOLOS_SIGNER_KEYPAIR_PATH=

# Market intelligence (Elfa Iris): optional until a tool that spends credits is used.
# Discovery, news, and summaries support Free; Chat needs Grow or PAYG. Every call
# bills credits (reported in the response) and is never retried automatically.
ELFA_API_KEY=
# Optional. Defaults to https://api.elfa.ai; plain http only for loopback test fixtures.
ELFA_BASE_URL=

# Jupiter Price V3 (solana_market_get_price): required to read a price, though the
# tool always lists without it. One request per call, never retried automatically.
JUPITER_API_KEY=
# Optional. Defaults to https://api.jup.ag; plain http only for loopback test fixtures.
JUPITER_BASE_URL=

# Harness, and free-text tool discovery: with this key, JEV (typesafe-ai/jev) ranks tools.
AI_GATEWAY_API_KEY=
ROUTER_PRESET=anthropic
# Optional. When set, traces are exported over OTLP/HTTP.
OTEL_EXPORTER_OTLP_ENDPOINT=

# MCP tool discovery: discover (default; tools are withheld until searched for) | all
# (advertise every tool the tier ceiling permits, for clients that ignore tools/list_changed).
# The --tools server flag wins when both are set.
SOLOS_TOOLS=

# Logging: debug | info | warn | error
SOLOS_LOG_LEVEL=info

# The developer lever (`solos dev ...`) appears only when SOLOS_DEV=1. `bun run solos` sets it;
# an installed solos runs without it (ADR-0034).
