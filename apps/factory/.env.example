# Vercel Connect connector UID for the factory's GitHub App. Create it with
# `vercel connect create` (or the deploy flow) and paste the UID. The token is
# brokered per call and never reaches the model or a sandbox.
GITHUB_CONNECTOR=github/solos-factory

# The repository the factory works on, owner/repo. The GitHub App behind
# GITHUB_CONNECTOR must be installed with access to it: the deployment clones
# it to prewarm the station sandboxes.
FACTORY_REPO=GuiBibeau/solos

# Optional overrides; every one has a solOS default.
# FACTORY_LABEL="agent-ready"                          # the label that hands an issue to the factory
# FACTORY_BRANCH_PREFIX="factory/"                     # branch prefix marking the factory's own PRs
# FACTORY_SETUP_COMMAND="bash scripts/factory-setup.sh" # runs once in the clone at template build
# FACTORY_BOT_NAME=""                                  # @mention name; defaults to the GitHub App's slug

# Z.ai uses the Coding Plan endpoint directly. Save this as a Vercel project secret
# for Production and Preview; never forward it into a sandbox.
ZAI_CODING_API_KEY=

# Models are <vendor>/<model> ids. Other vendors use AI Gateway. The reviewer must be a different
# vendor from the implementer; discovery fails otherwise.
# FACTORY_MODEL_ORCHESTRATOR="zai/glm-5.3-flash"
# FACTORY_MODEL_CLASSIFIER="zai/glm-5.3-flash"
# FACTORY_MODEL_ANALYST="zai/glm-5.3-flash"
# FACTORY_MODEL_IMPLEMENTER="zai/glm-5.3-flash"
# FACTORY_MODEL_RESEARCHER="zai/glm-5.3-flash"
# FACTORY_MODEL_REVIEWER="openai/gpt-5.6-luna"
# Gateway providers allowed to serve DeepSeek (default excludes Alibaba: its output inspection
# rejects signer/private-key vocabulary mid-turn).
# FACTORY_GATEWAY_PROVIDERS="deepseek,fireworks,deepinfra,runware"
# FACTORY_MODEL_JUDGE="zai/glm-5.3-flash"   # evals only

# Never set here, never set on the Vercel project, never present in a sandbox:
# SOLOS_*, SOLANA_*, AI_GATEWAY_API_KEY. The factory holds no signer, RPC URL,
# profile, or gateway key; the gateway and Blob authenticate with the
# deployment's OIDC token.
