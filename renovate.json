{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":preserveSemverRanges"],
  "schedule": ["before 8am on monday"],
  "timezone": "America/Montreal",
  "labels": ["deps"],
  "rangeStrategy": "pin",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 8am on monday"] },
  "packageRules": [
    { "groupName": "solana", "matchPackagePatterns": ["^@solana/", "^@solana-program/"] },
    { "groupName": "effect", "matchPackagePatterns": ["^effect$", "^@effect/"] },
    { "groupName": "ai-sdk", "matchPackagePatterns": ["^ai$", "^@ai-sdk/"] },
    { "groupName": "mcp", "matchPackagePatterns": ["^@modelcontextprotocol/"] },
    {
      "groupName": "lint",
      "matchPackagePatterns": [
        "eslint",
        "^@biomejs/",
        "^dependency-cruiser$",
        "^typescript$",
        "^globals$"
      ]
    },
    {
      "description": "Auto-merge devDependency minor/patch once CI is green (ADR-0016)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Surfpool version pinned for repository tooling",
      "fileMatch": ["^\\.surfpool-version$"],
      "matchStrings": ["^(?<currentValue>[0-9.]+)\\s*$"],
      "depNameTemplate": "solana-foundation/surfpool",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Bun version pinned for repository tooling",
      "fileMatch": ["^\\.bun-version$"],
      "matchStrings": ["^(?<currentValue>[0-9.]+)\\s*$"],
      "depNameTemplate": "oven-sh/bun",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^bun-v(?<version>.*)$"
    }
  ]
}
